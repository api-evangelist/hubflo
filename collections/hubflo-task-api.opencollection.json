                "description": "Number of items per page (max 100)"
              },
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the assigned users of a task"
        },
        {
          "info": {
            "name": "Retrieves the tasks",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/tasks",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "overdue",
                "value": "",
                "type": "query",
                "description": "Filter by overdue tasks"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Filter by project ID"
              },
              {
                "name": "contact_id",
                "value": "",
                "type": "query",
                "description": "Filter by contact ID"
              },
              {
                "name": "assignee_id",
                "value": "",
                "type": "query",
                "description": "Filter by assignee ID"
              },
              {
                "name": "creator_type",
                "value": "",
                "type": "query",
                "description": "Filter by creator type (user or contact)"
              },
              {
                "name": "completed",
                "value": "",
                "type": "query",
                "description": "Filter by completion status"
              },
              {
                "name": "parent_id",
                "value": "",
                "type": "query",
                "description": "Filter by parent task ID. If not provided, the endpoint will return\nfirst level tasks (no subtasks).\n"
              },
              {
                "name": "clickup_id",
                "value": "",
                "type": "query",
                "description": "Filter by clickup_id"
              },
              {
                "name": "monday_id",
                "value": "",
                "type": "query",
                "description": "Filter by monday_id"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query",
                "description": "Filter by tag"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the tasks. Only the first 100 tags of the task are returned"
        },
        {
          "info": {
            "name": "Creates a task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/tasks",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a task.\n        To fill in a custom field, add the custom field 'serialization_name' to the request\n        params, with the desired value. Only 100 tags maximum can be specified.\n        When you specify a `parent_task_id` you will create a subtask. Some attributes are not available for subtasks:\n        `clickup_id`, `monday_id`, `project_id` and `contact_id`.\n        To attach a recurrence, set `recurrence_type` (`Weekly`, `Monthly`, `Yearly`, `Periodically`, `Custom`) along\n        w"
        },
