{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room invoice API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "invoice",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sends an invoice to its recipient",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/deliveries",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Sends an issued invoice to its recipient by email"
        },
        {
          "info": {
            "name": "Issues an invoice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/issuances",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Changes a draft invoice status to issued"
        },
        {
          "info": {
            "name": "Creates a payment notice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/payment-notice",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create a payment notice for a given invoice, and mark it as paid. In case of partial payment, it will add up."
        },
        {
          "info": {
            "name": "Creates a payment URL",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/payment-url",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Create the payment url for a given invoice, or update it when it already exists"
        },
        {
          "info": {
            "name": "Retrieves the line_items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/line-items",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the line_items"
        },
        {
          "info": {
            "name": "Creates a line item for an invoice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/line-items",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Adds a new line item to an existing draft invoice"
        },
        {
          "info": {
            "name": "Retrieves a line item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/line-items/:id",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Line item ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the line item"
        },
        {
          "info": {
            "name": "Updates a line item",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/line-items/:id",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Line item ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a line item of a draft invoice"
        },
        {
          "info": {
            "name": "Deletes a line item",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.hubflo.com/api/v2/invoices/:invoice_id/line-items/:id",
            "params": [
              {
                "name": "invoice_id",
                "value": "",
                "type": "path",
                "description": "Invoice ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Line item ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a line item of a draft invoice"
        },
        {
          "info": {
            "name": "Retrieves the invoices",
