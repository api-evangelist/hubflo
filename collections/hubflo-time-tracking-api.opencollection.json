{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room time_tracking API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "time_tracking",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the time trackings",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/time_trackings",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the time trackings"
        },
        {
          "info": {
            "name": "Creates a time tracking",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/time_trackings",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the created time tracking"
        },
        {
          "info": {
            "name": "Retrieves a time tracking",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/time_trackings/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Time tracking ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a time tracking"
        },
        {
          "info": {
            "name": "Updates a time tracking",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.hubflo.com/api/v2/time_trackings/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Time tracking ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a time tracking"
        }
      ]
    }
  ],
  "bundled": true
}