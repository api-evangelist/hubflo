{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room member API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "member",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/members",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Filter by email"
              },
              {
                "name": "role",
                "value": "",
                "type": "query",
                "description": "Filter by role"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the members of the current organization"
        }
      ]
    }
  ],
  "bundled": true
}