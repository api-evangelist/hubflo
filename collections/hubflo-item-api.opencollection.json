{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room item API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "item",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/items",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "library",
                "value": "",
                "type": "query",
                "description": "Filter by library"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by content type"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "query",
                "description": "Filter by workspace"
              },
              {
                "name": "title",
                "value": "",
                "type": "query",
                "description": "Filter by title"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns content items"
        }
      ]
    }
  ],
  "bundled": true
}