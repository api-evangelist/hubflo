{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room task API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "task",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the assigned contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/tasks/:task_id/contacts",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the assigned contacts of a task. Only the first 100 tags of each contact are returned."
        },
        {
          "info": {
            "name": "Retrieves the files for a task",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/tasks/:task_id/files",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the files for a task"
        },
        {
          "info": {
            "name": "Creates a file for a task",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/tasks/:task_id/files",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              },
              {
                "name": "file_id",
                "value": "",
                "type": "query",
                "description": "File ID"
              },
              {
                "name": "library",
                "value": "",
                "type": "query",
                "description": "Add to library"
              },
              {
                "name": "title",
                "value": "",
                "type": "query",
                "description": "Title (ignored when file_id is provided)"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": []
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a file for a task. It can be created giving the uploaded file, or imported from the library,\n        using the file_id attribute."
        },
        {
          "info": {
            "name": "Retrieves a file for a task",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/tasks/:task_id/files/:id",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "File ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a file for a task"
        },
        {
          "info": {
            "name": "Updates a file for a task",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.hubflo.com/api/v2/tasks/:task_id/files/:id",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "File ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a file for a task. You can only change the title of the file."
        },
        {
          "info": {
            "name": "Retrieves the assigned users of a task",
            "type": "http"
