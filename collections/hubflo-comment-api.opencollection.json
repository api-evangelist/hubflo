{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room comment API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "comment",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves task comments",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/tasks/:task_id/comments",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all comments associated with a task, sorted by creation date in descending order"
        },
        {
          "info": {
            "name": "Creates a comment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/tasks/:task_id/comments",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Add a comment to a task.\n        Specify the author of the comment with the author_id parameter."
        },
        {
          "info": {
            "name": "Retrieves a comment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/tasks/:task_id/comments/:id",
            "params": [
              {
                "name": "task_id",
                "value": "",
                "type": "path",
                "description": "Task ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Comment ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a specific comment of a task"
        }
      ]
    }
  ],
  "bundled": true
}