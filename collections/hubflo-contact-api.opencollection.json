{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room contact API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "contact",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the workspaces of the given contact. Only the first 100 tags of each workspace are returned",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/contacts/:contact_id/workspaces",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "contact_id",
                "value": "",
                "type": "path",
                "description": "Contact ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the workspaces"
        },
        {
          "info": {
            "name": "Retrieves a workspace of the given contact. Only the first 100 tags of the workspace are returned",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/contacts/:contact_id/workspaces/:id",
            "params": [
              {
                "name": "contact_id",
                "value": "",
                "type": "path",
                "description": "Contact ID"
              },
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the workspace"
        },
        {
          "info": {
            "name": "Retrieves the contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/contacts",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "owner_id",
                "value": "",
                "type": "query",
                "description": "Filter by owner ID"
              },
              {
                "name": "phone",
                "value": "",
                "type": "query",
                "description": "Filter by phone number"
              },
              {
                "name": "email",
                "value": "",
                "type": "query",
                "description": "Filter by email"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Filter by project ID"
              },
              {
                "name": "company_id",
                "value": "",
                "type": "query",
                "description": "Filter by company ID"
              },
              {
                "name": "contact_id",
                "value": "",
                "type": "query",
                "description": "Filter by contact ID"
              },
              {
                "name": "linkedin",
                "value": "",
                "type": "query",
                "description": "Filter by LinkedIn"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the contacts. Only the first 100 tags of each contact are returned"
        },
        {
          "info": {
            "name": "Creates a contact",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/contacts",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a contact. Only 100 tags maximum can be specified.\n        To fill in a custom field, add the custom field 'serialization_name' to the request\n        params, with the desired value."
        },
        {
          "info": {
            "name": "Retrieves a contact",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/contacts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Contact ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the contact. Only the first 100 tags of the contact are returned"
        },
        {
          "info": {
            "name": "Updates a contact",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.hubflo.com/api/v2/contacts/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Contact ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a contact. Only 100 tags maximum can be specified. If the tags key is present, the tags provided in the request will replace the existing tags. To fill in a custom field, add the custom field 'serialization_name' to the request params, with the desired value."
        }
      ]
    }
  ],
  "bundled": true
}