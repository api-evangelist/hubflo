{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room tag API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "tag",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/tags",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the tags of the current organization"
        },
        {
          "info": {
            "name": "Creates a tag",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/tags",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the created tag"
        },
        {
          "info": {
            "name": "Updates a tag",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.hubflo.com/api/v2/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Tag ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the updated tag"
        },
        {
          "info": {
            "name": "Deletes a tag",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.hubflo.com/api/v2/tags/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Tag ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Deletes a tag"
        }
      ]
    }
  ],
  "bundled": true
}