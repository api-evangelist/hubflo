{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room message API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "message",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the files for a message",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/messages/:message_id/files",
            "params": [
              {
                "name": "message_id",
                "value": "",
                "type": "path",
                "description": "Message ID"
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the files attached to a message"
        }
      ]
    }
  ],
  "bundled": true
}