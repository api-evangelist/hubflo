              },
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Filter by project ID"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by status"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the invoices"
        },
        {
          "info": {
            "name": "Creates an invoice",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/invoices",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a draft invoice (without line items)"
