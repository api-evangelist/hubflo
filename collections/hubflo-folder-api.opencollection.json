{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room folder API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "folder",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the accesses to the given folder",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/workspaces/:workspace_id/folders/:folder_id/accesses",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              },
              {
                "name": "folder_id",
                "value": "",
                "type": "path",
                "description": "Folder ID"
              },
              {
                "name": "actor_type",
                "value": "",
                "type": "query",
                "description": "Actor type (User, ContactInvitation, Contact)"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the accesses"
        },
        {
          "info": {
            "name": "Adds an access to the given folder",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/workspaces/:workspace_id/folders/:folder_id/accesses",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              },
              {
                "name": "folder_id",
                "value": "",
                "type": "path",
                "description": "Folder ID"
              },
              {
                "name": "actor_type",
                "value": "",
                "type": "query",
                "description": "Actor type (User, ContactInvitation, Contact)"
              },
              {
                "name": "actor_id",
                "value": "",
                "type": "query",
                "description": "Actor ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Grants access to an actor"
        },
        {
          "info": {
            "name": "Removes an access from the given folder",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://app.hubflo.com/api/v2/workspaces/:workspace_id/folders/:folder_id/accesses",
            "params": [
              {
                "name": "workspace_id",
                "value": "",
                "type": "path",
                "description": "Workspace ID"
              },
              {
                "name": "folder_id",
                "value": "",
                "type": "path",
                "description": "Folder ID"
              },
              {
                "name": "actor_type",
                "value": "",
                "type": "query",
                "description": "Actor type (User, ContactInvitation, Contact)"
              },
              {
                "name": "actor_id",
                "value": "",
                "type": "query",
                "description": "Actor ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Revokes access for an actor"
        }
      ]
    }
  ],
  "bundled": true
}