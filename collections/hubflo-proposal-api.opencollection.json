{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room proposal API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "proposal",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the contacts",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/proposals/:proposal_id/contacts",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "proposal_id",
                "value": "",
                "type": "path",
                "description": "Proposal ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the list of contacts for a proposal. Only the first 100 tags of each contact are returned."
        },
        {
          "info": {
            "name": "Issues a proposal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/proposals/:proposal_id/issuances",
            "params": [
              {
                "name": "proposal_id",
                "value": "",
                "type": "path",
                "description": "Proposal ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Changes a draft proposal status to issued"
        },
        {
          "info": {
            "name": "Retrieves the metadata of a proposal",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/proposals/:id/metadata",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Proposal ID"
              },
              {
                "name": "contact_id",
                "value": "",
                "type": "query",
                "description": "Contact ID"
              },
              {
                "name": "contact_email",
                "value": "",
                "type": "query",
                "description": "Contact email"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Retrieves the metadata of a proposal. Contact ID or email must be provided to retrieve recipient-specific metadata such as view count."
        },
        {
          "info": {
            "name": "Retrieves the line_items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/proposals/:proposal_id/line-items",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "proposal_id",
                "value": "",
                "type": "path",
                "description": "Proposal ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the line_items"
        },
        {
          "info": {
            "name": "Creates a quote item for a proposal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/proposals/:proposal_id/line-items",
            "params": [
              {
                "name": "proposal_id",
                "value": "",
                "type": "path",
                "description": "Proposal ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Adds a new quote item to an existing draftproposal"
        },
        {
          "info": {
            "name": "Retrieves the proposals",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/proposals",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "contact_id",
                "value": "",
                "type": "query",
                "description": "Filter by contact ID"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Filter by project ID"
              },
              {
                "name": "status",
                "value": "",
                "type": "query",
                "description": "Filter by status"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the proposals"
        },
        {
          "info": {
            "name": "Creates a proposal",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/proposals",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a draft proposal (without line items)"
        },
        {
          "info": {
            "name": "Retrieves a proposal",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/proposals/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Proposal ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the proposal"
        }
      ]
    }
  ],
  "bundled": true
}