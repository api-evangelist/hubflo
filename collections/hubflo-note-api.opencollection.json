{
  "opencollection": "1.0.0",
  "info": {
    "name": "Hubflo chat_room note API",
    "version": "v2"
  },
  "items": [
    {
      "info": {
        "name": "note",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieves the notes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/notes",
            "params": [
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "per_page",
                "value": "10",
                "type": "query",
                "description": "Number of items per page (max 100)"
              },
              {
                "name": "contact_id",
                "value": "",
                "type": "query",
                "description": "Filter by contact ID"
              },
              {
                "name": "contact_email",
                "value": "",
                "type": "query",
                "description": "Filter by contact email"
              },
              {
                "name": "project_id",
                "value": "",
                "type": "query",
                "description": "Filter by project ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns the notes"
        },
        {
          "info": {
            "name": "Creates a note",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://app.hubflo.com/api/v2/notes",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Creates a note, which can be linked to projects and / or contacts. The note will be added to the library."
        },
        {
          "info": {
            "name": "Retrieves a note",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/notes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Note ID"
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a notes"
        },
        {
          "info": {
            "name": "Updates a note",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://app.hubflo.com/api/v2/notes/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Note ID"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Updates a note"
        }
      ]
    }
  ],
  "bundled": true
}