        {
          "info": {
            "name": "Retrieves an invoice",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://app.hubflo.com/api/v2/invoices/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
